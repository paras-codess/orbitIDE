// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MODEL
// ==========================================
model User {
  id        String   @id @default(uuid())
  name      String   @unique
  email     String   @unique
  password  String?
  avatar    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // OAuth fields
  googleId     String?  @unique @map("google_id")
  authProvider String   @default("local") @map("auth_provider")

  // Email verification fields
  isVerified               Boolean   @default(false) @map("is_verified")
  verificationToken        String?   @map("verification_token")
  verificationTokenExpires DateTime? @map("verification_token_expires")

  // Relations
  submissions         Submission[]
  userTopicStats      UserTopicStat[]
  contests            Contest[]
  contestParticipants ContestParticipant[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// ==========================================
// PROBLEM MODEL
// ==========================================
model Problem {
  id          String     @id @default(uuid())
  title       String     @unique
  description String     @db.Text
  difficulty  Difficulty
  topic       String
  subtopic    String?
  constraints String?    @db.Text
  inputFormat String?    @map("input_format") @db.Text
  outputFormat String?   @map("output_format") @db.Text
  sampleInput  String?   @map("sample_input") @db.Text
  sampleOutput String?   @map("sample_output") @db.Text
  editorial   String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  submissions     Submission[]
  testCases       TestCase[]
  contestProblems ContestProblem[]

  @@map("problems")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ==========================================
// TEST CASE MODEL
// ==========================================
model TestCase {
  id        String  @id @default(uuid())
  problemId String  @map("problem_id")
  input     String  @db.Text
  output    String  @db.Text
  isHidden  Boolean @default(true) @map("is_hidden")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("test_cases")
  @@index([problemId])
}

// ==========================================
// SUBMISSION MODEL
// ==========================================
model Submission {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  problemId     String   @map("problem_id")
  contestId     String?  @map("contest_id")
  language      String
  code          String   @db.Text
  verdict       Verdict  @default(PENDING)
  executionTime Int?     @map("execution_time") // in milliseconds
  memoryUsage   Int?     @map("memory_usage")   // in KB
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("submissions")
  @@index([userId])
  @@index([problemId])
  @@index([contestId])
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  COMPILATION_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
}

// ==========================================
// USER TOPIC STATS MODEL
// ==========================================
model UserTopicStat {
  id              String @id @default(uuid())
  userId          String @map("user_id")
  topic           String
  solved          Int    @default(0)
  failed          Int    @default(0)
  accuracy        Float  @default(0)
  confidenceScore Float  @default(0) @map("confidence_score")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@map("user_topic_stats")
  @@index([userId])
}

// ==========================================
// CONTEST MODEL
// ==========================================
enum ContestType {
  SOLO
  ROOM
  SCHEDULED
}

model Contest {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  startTime   DateTime? @map("start_time")
  endTime     DateTime? @map("end_time")
  duration    Int?     // Duration in minutes
  type        ContestType @default(SOLO)
  code        String?  @unique // Join code for ROOM contests
  createdBy   String   @map("created_by")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  creator      User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  problems     ContestProblem[]
  participants ContestParticipant[]
  submissions  Submission[]

  @@map("contests")
  @@index([createdBy])
}

// ==========================================
// CONTEST PROBLEM MODEL
// ==========================================
model ContestProblem {
  id        String @id @default(uuid())
  contestId String @map("contest_id")
  problemId String @map("problem_id")
  order     Int    @default(0)
  points    Int    @default(100)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId])
  @@map("contest_problems")
  @@index([problemId])
}

// ==========================================
// CONTEST PARTICIPANT MODEL
// ==========================================
model ContestParticipant {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  score     Int      @default(0)
  penalty   Int      @default(0)
  joinedAt  DateTime @default(now()) @map("joined_at")
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@map("contest_participants")
  @@index([userId])
}
