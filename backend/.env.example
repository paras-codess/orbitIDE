# OrbitIDE AI Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/orbitide?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT (will be used in Phase 2)
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# Gemini AI (will be used in Phase 7)
GEMINI_API_KEY="your-gemini-api-key"

# Redis (will be used later)
REDIS_URL="redis://localhost:6379"

# Judge0 API (Code Execution Engine)
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY="your-rapidapi-key-for-judge0"
